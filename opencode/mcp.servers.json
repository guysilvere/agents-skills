{
  "$comment": "Source de vérité MCP Agence Bulles — AUCUN secret en clair. Les tokens sont référencés par {{TOKEN:nom}} et résolus par scripts/sync-skills.sh depuis ~/.config/opencode/.tokens/<nom> (chmod 600). Formats de sortie : opencode.jsonc (OC, {file:...}) et mcp_config.json (AG, injection directe). Doc AG : antigravity.google/docs/mcp.",
  "servers": [
    {
      "name": "Notion",
      "transport": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": false,
      "oc": {},
      "ag": {}
    },
    {
      "name": "github",
      "transport": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {{TOKEN:github}}"
      },
      "oc": {},
      "ag": {}
    },
    {
      "name": "brevo",
      "transport": "local",
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://mcp.brevo.com/v1/brevo/mcp",
        "--header",
        "Authorization:Bearer {{TOKEN:brevo}}"
      ],
      "enabled": true,
      "oc": {},
      "ag": {}
    },
    {
      "name": "coolify",
      "transport": "remote",
      "url": "https://home.agencebulles.net/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {{TOKEN:coolify}}"
      },
      "oc": {},
      "ag": {}
    },
    {
      "name": "geniuspay",
      "transport": "remote",
      "url": "https://geniuspay.ci/api/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {{TOKEN:geniuspay}}"
      },
      "oc": {},
      "ag": {}
    }
  ]
}
