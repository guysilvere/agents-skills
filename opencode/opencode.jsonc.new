{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-flash",
  "small_model": "deepseek/deepseek-v4-flash",
  "default_agent": "lead-dev",
  "mcp": {
    "Notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {file:/Users/silveremeya/.config/opencode/.tokens/github}"
      }
    },
    "coolify": {
      "type": "remote",
      "url": "https://home.agencebulles.net/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {file:/Users/silveremeya/.config/opencode/.tokens/coolify}"
      }
    },
    "brevo": {
      "type": "local",
      "command": [
        "npx",
        "mcp-remote",
        "https://mcp.brevo.com/v1/brevo/mcp",
        "--header",
        "Authorization:Bearer {file:/Users/silveremeya/.config/opencode/.tokens/brevo}"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "@franlol/opencode-md-table-formatter@latest",
    "@xberg-io/opencode-xberg",
    "@xberg-io/opencode-crawlberg",
    "@xberg-io/opencode-html-to-markdown",
    "@xberg-io/opencode-tree-sitter-language-pack",
    "@sveltejs/opencode",
    "@prevalentware/opencode-goal-plugin"
  ]
}
